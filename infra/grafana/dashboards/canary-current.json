  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["trader", "canary", "phase-3"],
  "templating": {
    "list": [
      {
        "name": "run_id",
        "label": "run_id",
        "type": "query",
        "datasource": {"type": "loki", "uid": "loki"},
        "query": {
          "label": "run_id",
          "stream": "{job=~\"testnet_.+|paper_.+\"}",
          "type": 1,
          "refId": "LokiVariableQueryEditor-VariableQuery"
        },
        "multi": true,
        "includeAll": true,
        "allValue": ".+",
        "refresh": 2,
        "sort": 5,
        "current": {"text": "All", "value": "$__all"}
      }
    ]
  },
  "time": {"from": "now-7d", "to": "now"},
  "timepicker": {},
  "timezone": "utc",
  "title": "Canary — Current Testnet Run",
  "uid": "canary-current",
  "version": 1,
  "weekStart": ""
