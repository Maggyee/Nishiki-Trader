[Unit]
Description=Nishiki Research Protocol v5 daily Binance snapshot collector
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=nishiki
Group=nishiki
WorkingDirectory=/opt/nishiki-trader
EnvironmentFile=/etc/nishiki-trader/research-v5.env
ExecStart=/opt/nishiki-trader/.venv/bin/python -m apps.ops.research_v5_daily --data-root ${RESEARCH_V5_DATA_ROOT} --expected-git-commit ${TRADER_GIT_SHA} --repo-root /opt/nishiki-trader
TimeoutStartSec=20min
Nice=10

[Install]
WantedBy=multi-user.target
