[Unit]
Description=Nishiki Research Protocol v5 daily Binance snapshot collector
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=nishiki
Group=nishiki
WorkingDirectory=/opt/nishiki-trader
EnvironmentFile=/etc/nishiki-trader/research-v5.env
ExecStart=/usr/bin/docker compose --env-file /etc/nishiki-trader/research-v5.env -f infra/research-v5/compose.yml run --rm --no-deps collector
TimeoutStartSec=20min
Nice=10

[Install]
WantedBy=multi-user.target
