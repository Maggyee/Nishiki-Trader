{
  "schema_version": "research.data_sources.v21",
  "status": "locked_before_fred_historical_body_access",
  "provider": "Federal Reserve Economic Data (FRED), Federal Reserve Bank of St. Louis",
  "authentication": "none",
  "base_url": "https://fred.stlouisfed.org/graph/fredgraph.csv",
  "requests": [
    {"series_id": "WALCL", "units": "millions_usd", "frequency": "weekly_as_of_wednesday", "cosd": "2019-10-01", "coed": "2022-12-31"},
    {"series_id": "WDTGAL", "units": "millions_usd", "frequency": "weekly_as_of_wednesday", "cosd": "2019-10-01", "coed": "2022-12-31"},
    {"series_id": "RRPONTSYD", "units": "billions_usd", "frequency": "daily", "cosd": "2019-10-01", "coed": "2022-12-31"}
  ],
  "request_policy": {
    "method": "GET",
    "maximum_body_openings": 3,
    "retry_allowed": false,
    "redirects_allowed": true,
    "required_content_type": "text/csv_or_csv_attachment"
  },
  "schema_contract": {
    "date_column": "observation_date",
    "value_column_equals_series_id": true,
    "date_format": "YYYY-MM-DD",
    "missing_value_marker": ".",
    "dates_unique_and_strictly_increasing": true,
    "values_finite_and_nonnegative": true
  },
  "join_and_transform": {
    "join": "exact observation_date intersection across all three series",
    "formula_millions_usd": "WALCL - WDTGAL - (1000 * RRPONTSYD)",
    "decision_timestamp": "observation_date plus 7 calendar days at 00:00:00Z",
    "forward_fill_allowed": false,
    "interpolation_allowed": false
  },
  "coverage_gates": {
    "warmup_start": "2019-10-01",
    "development_start": "2020-01-01",
    "development_end": "2022-12-31",
    "minimum_development_common_observations": 150,
    "minimum_warmup_common_observations": 8,
    "first_development_observation_no_later_than": "2020-01-08",
    "last_development_observation_no_earlier_than": "2022-12-28",
    "maximum_common_calendar_gap_days": 14
  },
  "failure_policy": "Any request, schema, unit, coverage, ordering, join, or value failure rejects provider qualification for v21 without retry, substitution, filling, or strategy PnL.",
  "historical_vintage_claim": false
}
