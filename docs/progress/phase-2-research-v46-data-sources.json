{
  "schema_version": "research.data_sources.v46.v1",
  "provider": "Binance Public Vision Futures Archive",
  "symbols": {
    "btc_premium": {
      "symbol": "BTCUSDT",
      "base_url": "https://data.binance.vision/data/futures/um/monthly/premiumIndexKlines/BTCUSDT/1d/",
      "format": "csv_daily_kline"
    }
  },
  "metrics": {
    "btc_prem_diff5_negative": {
      "metric_name": "BTC Premium Index 5-day delta < 0",
      "formula": "Premium(D) - Premium(D-5) < 0.0"
    },
    "btc_prem_diff5_loose": {
      "metric_name": "BTC Premium Index 5-day delta < 0.00001",
      "formula": "Premium(D) - Premium(D-5) < 0.00001"
    },
    "btc_prem_diff5_minhold2": {
      "metric_name": "BTC Premium Index 5-day delta < 0 (min hold 2d)",
      "formula": "Premium(D) - Premium(D-5) < 0.0 with min 2d hold"
    }
  },
  "boundaries": {
    "loads_credentials": false,
    "historical_vintage_claim": false,
    "point_in_time_interpretation": "binance_vision_premium_index_closed_daily_bars_lagged_1_calendar_day"
  }
}
