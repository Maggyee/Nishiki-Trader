      "index": "VXSLV",
      "url": "https://cdn.cboe.com/api/global/us_indices/daily_prices/VXSLV_History.csv",
      "accepted_columns": [["DATE", "VXSLV"], ["DATE", "OPEN", "HIGH", "LOW", "CLOSE"]],
      "value_column_by_schema": {"scalar": "VXSLV", "ohlc": "CLOSE"}
