{
  "schema_version": "research.data_sources.v47.v1",
  "provider": "Binance Public Spot Market Data",
  "symbols": {
    "btc_spot": {
      "symbol": "BTCUSDT",
      "base_url": "https://data.binance.vision/data/spot/monthly/klines/BTCUSDT/1d/",
      "format": "csv_daily_kline"
    }
  },
  "metrics": {
    "btc_rvol_relief_5_20": {
      "metric_name": "BTC 5-day Realized Volatility < 20-day Realized Volatility",
      "formula": "RVol_5d(D) < RVol_20d(D)"
    },
    "btc_rvol_relief_5_20_loose": {
      "metric_name": "BTC 5-day Realized Volatility < 1.02 * 20-day Realized Volatility",
      "formula": "RVol_5d(D) < 1.02 * RVol_20d(D)"
    },
    "btc_rvol_relief_5_20_minhold2": {
      "metric_name": "BTC 5-day Realized Volatility < 20-day Realized Volatility (min hold 2d)",
      "formula": "RVol_5d(D) < RVol_20d(D) with min 2d hold"
    }
  },
  "boundaries": {
    "loads_credentials": false,
    "historical_vintage_claim": false,
    "point_in_time_interpretation": "binance_spot_closed_daily_bars_lagged_1_calendar_day"
  }
}
