{
  "schema_version": "research.protocol.v24",
  "status": "preregistered_before_alternative_fng_body_access",
  "created_at": "2026-08-13",
  "objective": "Test three official Crypto Fear and Greed classification holds for BTCUSDT Spot without reopening Cboe volatility/option-surface identities, OFR stress, FRED net liquidity, Wikipedia pageviews, or on-chain fundamentals.",
  "data_access_disclosure": {
    "official_api_documentation_opened": true,
    "historical_json_bodies_opened": false,
    "development_factor_values_opened": false,
    "confirmation_factor_values_opened": false,
    "strategy_specific_pnl_opened": false
  },
  "research_windows": {
    "warmup": {"start": "2019-11-01", "end": "2019-12-31"},
    "development": {"start": "2020-01-01", "end": "2022-12-31", "strategy_specific_pnl_access_status": "unconsumed", "max_openings": 1},
    "confirmation": {"start": "2023-01-01", "end": "2025-12-31", "strategy_specific_pnl_access_status": "sealed_until_development_pass", "max_openings": 1},
    "future_blind": {"start": "2026-09-01", "end": "2027-01-31", "status": "sealed_unopened"}
  },
  "data_contract": {
    "provider_contract": "docs/progress/phase-2-research-v24-data-sources.json",
    "provider": "alternative.me Crypto Fear and Greed Index",
    "conservative_decision_lag_calendar_days": 2,
    "historical_vintage_claim": false,
    "missing_data_policy": "no interpolation, no forward fill, and hold the current state until the next official observation"
  },
  "candidates": [
    {
      "key": "extreme_fear_hold",
      "source": "rule_alternative_extreme_fear_hold_v1",
      "model_version": "alternative-fng-extreme-fear-lag2d-v1",
      "long_classifications": ["Extreme Fear"],
      "parameters": {"publication_lag_calendar_days": 2, "ttl_seconds": 86400, "confidence": 0.75},
      "rule": "buy iff the latest official value_classification is Extreme Fear; flat otherwise; begin flat and emit only on state change"
    },
    {
      "key": "fear_hold",
      "source": "rule_alternative_fear_hold_v1",
      "model_version": "alternative-fng-fear-or-extreme-fear-lag2d-v1",
      "long_classifications": ["Extreme Fear", "Fear"],
      "parameters": {"publication_lag_calendar_days": 2, "ttl_seconds": 86400, "confidence": 0.75},
      "rule": "buy iff the latest official value_classification is Extreme Fear or Fear; flat otherwise; begin flat and emit only on state change"
    },
    {
      "key": "non_greed_hold",
      "source": "rule_alternative_non_greed_hold_v1",
      "model_version": "alternative-fng-not-greed-or-extreme-greed-lag2d-v1",
      "long_classifications": ["Extreme Fear", "Fear", "Neutral"],
      "parameters": {"publication_lag_calendar_days": 2, "ttl_seconds": 86400, "confidence": 0.75},
      "rule": "buy iff the latest official value_classification is not Greed and not Extreme Greed; flat otherwise; begin flat and emit only on state change"
    }
  ],
  "execution": {
    "instrument_id": "BTCUSDT.BINANCE",
    "bar_type": "BTCUSDT.BINANCE-1-HOUR-LAST-EXTERNAL",
    "development_catalog_path": "data/research-v7-downtime-sensitivity/catalog",
    "confirmation_catalog_path": "data/research-v8/catalog",
    "trade_size_btc": 0.001,
    "starting_balance_usdt": 100000,
    "account_type": "cash",
    "min_confidence": 0.55,
    "long_flat_only": true,
    "costs_usdt_per_closed_position": {"gross": 0.0, "base": 0.08, "stress": 0.10}
  },
  "gates": {
    "development": {
      "base_net_pnl_gt": 0.0,
      "stress_net_pnl_gt": 0.0,
      "positive_calendar_years_at_least": 2,
      "positive_calendar_months_at_least": 18,
      "closed_positions_at_least": 30,
      "leave_best_position_base_net_pnl_gt": 0.0,
      "duplicate_replays_required": 2
    },
    "multiple_testing": {
      "candidate_count_locked": 3,
      "parameter_grid_search_forbidden": true,
      "alternate_sign_forbidden": true,
      "pnl_selected_ensemble_forbidden": true,
      "failed_candidate_reparameterization_forbidden": true
    }
  },
  "progression": {
